{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "types": ["vite/client", "vitest/globals", "node"],
    "baseUrl": ".",
    "paths": {
      "@dakia/ui": ["../../packages/ui/src/index.ts"],
      "@dakia/api-types": ["../../packages/api-types/src/index.ts"],
      "@dakia/mail-renderer": ["../../packages/mail-renderer/src/index.tsx"],
      "@dakia/mail-composer": ["../../packages/mail-composer/src/index.tsx"],
      "react": ["node_modules/@types/react"],
      "react/*": ["node_modules/@types/react/*"],
      "dompurify": ["node_modules/dompurify/dist/purify.es.d.mts"],
      "squire-rte": ["node_modules/squire-rte/dist/types/Squire.d.ts"]
    }
  },
  "include": [
    "src",
    "browser",
    "vite.config.ts",
    "playwright.config.ts",
    "../../packages/mail-renderer/src",
    "../../packages/mail-composer/src",
    "../../packages/ui/src"
  ]
}
