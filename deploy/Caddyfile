# Automatic HTTPS for the Compose package. The site address is DAKIA_ORIGIN,
# so certificates and the redirect from HTTP use the same host people open.
# Docker's internal DNS resolves the dakia service; use 127.0.0.1:3025 only
# when Caddy runs directly on the host instead of in Compose.
{$DAKIA_ORIGIN} {
	reverse_proxy dakia:3025
}
