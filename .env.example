# Use an HTTPS reverse proxy or Tailscale Serve. No trailing slash.
DAKIA_ORIGIN=https://mail.example.com
# Leave DAKIA_IMAGE unset to use the tested image pinned in compose.yaml.
# Override it only with a chosen version/digest, or dakia:local after a local build.
DAKIA_PORT=3025
# Set false to disable the owner's automatic GitHub release checks.
DAKIA_RELEASE_CHECKS=true

# Optional: Google OAuth client owned by this installation's operator.
# Create a Web application client with redirect URI:
# ${DAKIA_ORIGIN}/api/accounts/gmail/callback
# DAKIA_GMAIL_CLIENT_ID=your-client.apps.googleusercontent.com
# DAKIA_GMAIL_CLIENT_SECRET=your-client-secret
# Prefer DAKIA_GMAIL_SECRET_FILE with a private read-only mount; see docs/gmail-oauth.md.
