  "patterns": {
    "automated_sender_address": "(?i)^notify@updates[.]notion[.]com$",
    "automated_sender": "(?i)^(?:(?:no[-_.]?(?:reply|replies|response)|do[-_.]?not[-_.]?(?:reply|respond)|auto(?:mated|matic)?[-_.]?(?:repl(?:y|ies)|response|mail(?:er)?|notifications?)|info|automated|autoresponder|unmonitored|notifications?|alerts?|updates?|newsletters?|news|announcements?|bulletins?|digests?|reminders?|mailing[-_.]?list|mailer[-_.]?daemon|postmaster|bounces?|robot|bot)[0-9]*(?:[+._-].*)?|.+[._-](?:no[-_.]?reply|do[-_.]?not[-_.]?reply)[0-9]*)$",
    "valid_amount": "(?i)^(?:(?:USD|EUR|GBP|\\$|€|£)\\s*\\d+(?:[., \\x{00a0}\\x{202f}]\\d{3})*(?:[.,]\\d{2})?|\\d+(?:[., \\x{00a0}\\x{202f}]\\d{3})*(?:[.,]\\d{2})?\\s*(?:USD|EUR|GBP|€|£|\\$))$",
    "amount": "(?i)\\b(?:total(?: paid| due)?|amount paid|amount due|payment of)\\s*:?\\s*((?:USD|EUR|GBP|\\$|€|£)\\s*\\d[\\d., \\x{00a0}\\x{202f}]*|\\d[\\d., \\x{00a0}\\x{202f}]*\\s*(?:USD|EUR|GBP|€|£|\\$))(?:\\s|[;:!?)]|$)",
    "reference": "(?i)(?:order (?:number|reference|#)|booking reference|tracking number)\\s*[:#]?\\s*([A-Z0-9][A-Z0-9-]{3,24})\\b",
    "code_validity": "(?i)(?:expires? in|valid for)\\s+(\\d{1,3})\\s+(seconds?|minutes?|hours?)",
    "verification_code": "(?i)(?:verification code|security code|one[- ]time code|login code|sign-in code|authentication code|pin code|one[- ]time password|otp)\\s*(?:is|:|=)?\\s*([A-Z0-9]{4,10})\\b",
    "flight_route": "(?i)\\bfrom\\s+([A-Z]{3}\\s+to\\s+[A-Z]{3})\\b",
    "flight_number": "(?i)flight\\s*(?:number|no\\.?|#)?\\s*([A-Z]{2}\\s?\\d{1,4})\\b",
    "delivery_role_sender": "(?i)^(?:no[-_.]?reply|do[-_.]?not[-_.]?reply|notifications?|billing|invoices?|receipts?)(?:[+._-].*)?$",
    "receipt_subject": "(?i)\\byour(?: [\\p{L}\\p{N}'’-]+){0,4} receipt\\b|\\byour recent purchase\\b|^(?:thank you|thanks) for your(?: [\\p{L}\\p{N}'’-]+){0,4} purchase[!.]?\\s*$",
    "event_title": "(?s)^Invitation:(.*)",
    "document_mailer": "^sap netweaver|quadient inspire|opentext exstream",
    "reply_subject": "^re:",
    "unsubscribe_path": "unsubscribe"
  },
  "delivery_headers": [
    "X-SES-Outgoing",
    "X-SG-EID",
    "X-Mailgun-Sid",
    "X-MC-User",
    "Feedback-ID"
  ]
}
